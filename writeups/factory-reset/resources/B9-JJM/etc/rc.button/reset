#!/bin/sh
###########################################################################
## this script define the behavior of reset button
## one click:                  reboot system (OPID is not 0000)
## double click:               deep factory default reset
## press hold more than 10s:   factory default reset
###########################################################################

. /lib/functions/leds.sh
. /lib/functions.sh
. /usr/exe/varset.sh
if [ -e /usr/exe/reset_var.sh ];then
   . /usr/exe/reset_var.sh
fi

if [ "X$PRESS_HOLD_TIME" = "X" ]; then
export PRESS_HOLD_TIME=10
fi

if [ "X$DEEP_FAC_COUNT" = "X" ];then
export DEEP_FAC_COUNT=4
fi

if [ "X$PRESS_LED_FUNC" = "X" ];then
export PRESS_LED_FUNC=led_all_blink
fi

if [ "X$DEEP_LED_FUNC" = "X" ];then
export DEEP_LED_FUNC=led_all_on
fi

if [ "X$FAC_LED_FUNC" = "X" ];then
export FAC_LED_FUNC=led_all_on
fi


RESET_FILE=/configs/fresetOriginator.txt



CUR_HOLD_TIME=/tmp/btn_cur_hold_time
LAST_HOLD_TIME=/tmp/btn_last_hold_time

# INTERVAL TIME means last release to next press
INTERVAL_TIME=/tmp/btn_interval_time
BTN_ACTION=/tmp/btn_action

NO_DEEP_FLAG=/configs/NoDeepFactoryReset

CLICK_COUNT=/tmp/._short_click_count

led_all_blink()
{
        /usr/sbin/ledtool allblink
}

led_all_on()
{
        /usr/sbin/ledtool allon
}

no_action()
{
#####
	_slot_=1
}

opid=$(ritool get OperatorID | awk '{print $2}')
led_ctrl()
{
    press_time=`date +%s`
    while [ true ]
    do
    {
        cur_time=`date +%s`
        case "$(cat $BTN_ACTION)" in
            "pressed")
                hold_time=`expr $cur_time - $press_time`
                if [ $hold_time -ge $PRESS_HOLD_TIME ];then
                    $FAC_LED_FUNC
                    sleep 3
                    led_hold_time=`expr $PRESS_HOLD_TIME + 1`
                    export ACTION="released"
                    export SEEN="$led_hold_time"
                    /etc/rc.button/reset
                    exit 0
                else
                    $PRESS_LED_FUNC
                fi
            ;;
            "released")
            exit 0
            ;;
        esac
    }
    done
}

short_click_check()
{
	release_time=`date +%s`
	while [ true ]
	do
		cur_time=`date +%s`
		if [ $(cat $BTN_ACTION) = "pressed" ];then exit 0; fi

		# if no press action after release 1s, means one click
		interval_time=`expr $cur_time - $release_time`
		if [ $interval_time -gt 1 -a $(cat $CLICK_COUNT) -ge 1 ];then
			echo 0 > $CLICK_COUNT
			if [ "X$opid" = "X0000" ]; then
				echo "[`date '+%F.%T%z'`]MSG: Reset button pressed" |tee -a /logs/${LOGDEFAULT} &>/dev/console
			else
				echo "[`date '+%F.%T%z'`]MSG: REBOOT due to reset button click" |tee -a /logs/${LOGDEFAULT} &>/dev/console
				reboot
			fi
			exit 0
		fi
	done
}

deep_fac_reset()
{
    echo "[`date '+%F.%T%z'`]MSG: Deep factory default reset due to reset button Quad click" |tee -a /logs/${LOGDEFAULT} &>/dev/console
    $DEEP_LED_FUNC
    /usr/exe/factory-default-reset all
}

fac_reset()
{
	if [ ! -f "$RESET_FILE" ]; then
		touch $RESET_FILE
		echo "LocalFactoryReset" > $RESET_FILE
		echo "LocalFactoryReset" > $RESET_FILE
	fi
	echo "[`date '+%F.%T%z'`]MSG: FACTORY RESET due to reset button click more than $PRESS_HOLD_TIME" |tee -a /logs/${LOGDEFAULT} &>/dev/console
	cfgcli backupkeyparam
	/usr/exe/factory-default-reset
}

_reset()
{
	echo "[`date '+%F.%T%z'`]MSG: RESET due to reset button click $(cat $CUR_HOLD_TIME) less than $PRESS_HOLD_TIME" |tee -a /logs/${LOGDEFAULT} &>/dev/console
	reboot -f
}

touch  $BTN_ACTION $CUR_HOLD_TIME $LAST_HOLD_TIME $INTERVAL_TIME

if [ ! -e $CLICK_COUNT ];then
	echo 0 > $CLICK_COUNT
fi

case "${ACTION}" in
   "pressed")
        echo $SEEN > $INTERVAL_TIME
        echo "${ACTION}" > $BTN_ACTION
        led_ctrl &
    ;;
    "released")
        echo "${ACTION}" > $BTN_ACTION
        echo $SEEN > $CUR_HOLD_TIME

        if [ $(cat $CUR_HOLD_TIME) -lt 1 -a $(cat $INTERVAL_TIME) -eq 0 ];then
                echo `expr $(cat $CLICK_COUNT) + 1` > $CLICK_COUNT
                if [ $(cat $CLICK_COUNT) -ge $DEEP_FAC_COUNT ];then
                    echo 0 > $CLICK_COUNT
                    deep_fac_reset
                fi
                short_click_check &
        else
            echo 0 > $CLICK_COUNT
        if [ $(cat $CUR_HOLD_TIME) -ge $PRESS_HOLD_TIME ]; then
            fac_reset
        elif [ $(cat $CUR_HOLD_TIME) -lt 1 ];then
            echo 1 > $CLICK_COUNT
            short_click_check &
        else
            _reset
        fi

        fi
    ;;
esac
