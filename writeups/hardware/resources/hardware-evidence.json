  "observations": {
    "cpu": "Four arm,cortex-a55 DT nodes; boot ID 0x411fd050; BL1 reports 1200 MHz. Package architecture aarch64_cortex-a53 is not a hardware probe.",
    "ddr": "Early boot says DDR3-1866: 32Bit mode; not an independently measured clock or a DVFS characterization.",
    "pci_endpoints": [
      {
        "host": "/pcie@f4325000",
        "endpoint": "0000:01:00.0",
        "pci_id": "17cb:1104",
        "driver": "cnss_pci",
        "link_gt_s": 5,
        "link_lanes": 2
      },
      {
        "host": "/pcie@f4326000",
        "endpoint": "0001:01:00.0",
        "pci_id": "17cb:1104",
        "driver": "cnss_pci",
        "link_gt_s": 5,
        "link_lanes": 2
      }
    ],
    "pci_bridge_database_label": "16c3:abcd is labelled DWC_usb3 in the captured PCI database; class 0604 and DT PCIe paths establish these are the radio PCI bridges.",
    "native_ethernet": "MDIO probes addresses 1 through 4 as 0x001cc981; experimental NI driver attaches PHY2, link negotiates 1000 Mbps full duplex. Later logs explicitly leave wire_tx unverified and RX unimplemented; descriptor consumption is not wire delivery.",
    "watchdog": "Stock node wdt@f432901c. Owner reported a delayed recovery-shell reset and supplied wdt dev watchdog@0xf432901c; wdt stop. Cause and sustained stability after stopping are unverified; see recovery evidence.",
    "dt_address_scope": "Stock peripherals use 0xf... DT addresses. Experimental native-kernel logs use 0x4f... for several blocks. These descriptions must not be interchanged without checking the relevant memory map."
  },
